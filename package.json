{
  "name": "bootcamp-project",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint --ext .js,.ts,.vue ",
    "lint:fix": "eslint --fix",
    "typecheck": "vue-tsc --noEmit -p .nuxt/tsconfig.app.json && vue-tsc --noEmit -p .nuxt/tsconfig.server.json && vue-tsc --noEmit -p .nuxt/tsconfig.shared.json && vue-tsc --noEmit -p .nuxt/tsconfig.node.json"
  },
  "dependencies": {
    "@vueuse/nuxt": "^14.3.0",
    "gsap": "^3.15.0",
    "nuxt": "^4.4.6",
    "vue": "^3.5.34",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@nuxt/eslint": "^1.15.2",
    "@nuxt/test-utils": "^3.23.0",
    "@nuxtjs/i18n": "^10.4.0",
    "@tailwindcss/vite": "^4.3.0",
    "@vue/test-utils": "^2.4.10",
    "happy-dom": "^20.9.0",
    "jiti": "^2.7.0",
    "nuxt-svgo": "^5.3.0",
    "prettier": "3.8.3",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.3.1"
  }
}
